{
  "name": "wif-viewer",
  "displayName": "WIF Viewer",
  "description": "View weaving draft files (.wif): threading, tie-up, treadling and a colored drawdown.",
  "version": "0.2.0",
  "publisher": "JGalego",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["wif", "weaving", "loom", "draft", "textile"],
  "repository": { "type": "git", "url": "https://github.com/JGalego/WIFviewer" },
  "main": "./src/extension.js",
  "activationEvents": ["onLanguage:wif", "onLanguage:markdown"],
  "contributes": {
    "languages": [
      {
        "id": "wif",
        "aliases": ["WIF", "Weaving Information File"],
        "extensions": [".wif"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/wif-file-light.svg",
          "dark": "./images/wif-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "wif",
        "scopeName": "source.wif",
        "path": "./syntaxes/wif.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "wifViewer.preview",
        "displayName": "WIF Viewer",
        "selector": [{ "filenamePattern": "*.wif" }],
        "priority": "default"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": ["./media/markdown.css"],
    "commands": [
      { "command": "wifViewer.openSource", "title": "WIF: Open as Text" },
      { "command": "wifViewer.openPreview", "title": "WIF: Open Preview" },
      { "command": "wifViewer.openSide", "title": "WIF: Open Text and Preview Side by Side", "icon": "$(open-preview)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "wifViewer.openSource", "when": "activeCustomEditorId == wifViewer.preview", "group": "navigation" },
        { "command": "wifViewer.openSide", "when": "resourceExtname == .wif", "group": "navigation" }
      ],
      "explorer/context": [
        { "command": "wifViewer.openSide", "when": "resourceExtname == .wif", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "package": "vsce package --readme-path docs/MARKETPLACE.md",
    "publish": "vsce publish --readme-path docs/MARKETPLACE.md"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
